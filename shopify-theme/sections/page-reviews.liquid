<div class="bg-[#f6f6f6] min-h-screen py-24 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-[#E30613] font-black tracking-widest uppercase text-xs mb-4 block">Wall of Love</span>
      <h1 class="text-4xl md:text-6xl font-black text-gray-900 mb-6 tracking-tight">10,000+ Happy Customers</h1>
      <p class="text-gray-500 font-medium text-lg">See why families across the country are switching to E-strip.</p>
    </div>

    <!-- Review Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {% for i in (1..9) %}
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
          <div class="flex text-yellow-400 text-[16px] mb-4">★★★★★</div>
          <h4 class="font-black text-gray-900 mb-2">Best switch I've ever made.</h4>
          <p class="text-gray-600 font-medium text-sm leading-relaxed mb-6">"I was skeptical that a little sheet could clean my kids' muddy clothes, but these completely blew me away. No plastic jugs, no mess, and they smell amazing. I'll never go back."</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
              <span class="font-black text-gray-400 text-xs">JD</span>
            </div>
            <div>
              <p class="font-bold text-gray-900 text-xs">Jane Doe</p>
              <p class="text-gray-400 text-xs font-medium">Verified Buyer</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews Page",
  "settings": []
}
{% endschema %}
