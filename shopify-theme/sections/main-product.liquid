<div class="min-h-screen bg-white">
  
  <!-- Breadcrumb -->
  <div class="bg-[#f6f6f6] py-3 px-4 border-b border-gray-100">
    <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-bold tracking-widest text-gray-500 uppercase">
      <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/collections/all" class="hover:text-gray-900 transition-colors">Shop</a>
      <span>/</span>
      <span class="text-gray-900">{{ product.title }}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Sticky Media Gallery -->
      <div class="w-full lg:w-3/5 lg:sticky lg:top-24">
        <div class="flex gap-4">
          <!-- Thumbnail strip (Desktop) -->
          <div class="hidden lg:flex flex-col gap-3 w-20 shrink-0">
            {% for image in product.images %}
              <div class="relative w-20 h-20 rounded-[4px] bg-gray-50 border border-gray-200 overflow-hidden cursor-pointer">
                <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | escape }}" class="w-full h-full object-contain p-2" />
              </div>
            {% endfor %}
          </div>
          
          <!-- Main Image -->
          <div class="relative w-full aspect-square bg-[#f6f6f6] rounded-[10px] overflow-hidden">
            <img src="{{ product.featured_image | img_url: '1024x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-contain p-4 mix-blend-multiply" />
            {% if product.tags contains 'Best Seller' %}
              <div class="absolute top-4 left-4 bg-[#E30613] text-white text-xs font-black px-3 py-1 rounded-[4px] uppercase tracking-wide">
                Best Seller
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Right Column: Product Details & Shopify Form -->
      <div class="w-full lg:w-2/5 flex flex-col pt-2">
        
        <!-- Reviews Summary -->
        <div class="flex items-center gap-2 mb-3 cursor-pointer hover:opacity-80 transition-opacity">
          <div class="flex gap-0.5 text-gray-900 text-[16px]">★★★★★</div>
          <span class="text-sm text-gray-500 font-bold">5.0 (4,231 reviews)</span>
        </div>

        <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-2 leading-tight">{{ product.title }}</h1>
        
        <div class="flex items-baseline gap-3 mb-8">
          <span class="text-2xl font-black text-gray-900">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="text-lg text-gray-400 line-through font-bold">{{ product.compare_at_price | money }}</span>
            <span class="bg-[#e040a0] text-white text-[10px] font-black px-2 py-0.5 rounded-[4px] tracking-wide uppercase">SALE</span>
          {% endif %}
        </div>

        <!-- Shopify Add to Cart Form -->
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          
          <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <div class="flex items-center border border-gray-300 rounded-[4px] overflow-hidden w-full sm:w-32 h-[50px] shrink-0 bg-white">
              <button type="button" class="flex-1 h-full text-gray-600 font-bold text-xl hover:bg-gray-50" onclick="document.getElementById('qty').stepDown()">−</button>
              <input type="number" id="qty" name="quantity" value="1" min="1" class="w-10 text-center font-black text-gray-900 text-sm border-none focus:ring-0 p-0 m-0 bg-transparent h-full appearance-none">
              <button type="button" class="flex-1 h-full text-gray-600 font-bold text-xl hover:bg-gray-50" onclick="document.getElementById('qty').stepUp()">+</button>
            </div>
            <button type="submit" name="add" class="btn flex-1 h-[50px] font-bold text-sm bg-[#2B3F50] text-white hover:opacity-90 transition-all flex items-center justify-center tracking-widest uppercase rounded-[9999px]">
              Add to Cart
            </button>
          </div>
        {% endform %}
        
        <!-- Trust strip -->
        <div class="flex items-center justify-center gap-6 py-4 mb-8 border-y border-gray-100 opacity-70">
          <span class="material-symbols-outlined text-[24px]">local_shipping</span>
          <span class="material-symbols-outlined text-[24px]">eco</span>
          <span class="material-symbols-outlined text-[24px]">workspace_premium</span>
        </div>

        <!-- Description -->
        <div class="border-t border-gray-200 py-6">
          <h3 class="font-bold text-gray-900 tracking-wide uppercase text-sm mb-4">Description</h3>
          <div class="text-gray-600 text-sm leading-relaxed font-medium">
            {{ product.description }}
          </div>
        </div>

      </div>
    </div>



  </div>
</div>

{% schema %}
{
  "name": "Main Product Funnel",
  "settings": []
}
{% endschema %}
