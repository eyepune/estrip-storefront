<div id="sticky-atc-bar" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-50 transform translate-y-full transition-transform duration-500 ease-in-out p-3 md:p-4">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 md:gap-6">
    
    <!-- Mobile View: Just price and button -->
    <div class="flex items-center justify-between w-full md:w-auto md:hidden">
      <div>
        <p class="text-xs text-gray-500 font-bold uppercase tracking-widest truncate max-w-[150px]">{{ product.title }}</p>
        <p class="text-lg font-black text-gray-900">{{ product.price | money }}</p>
      </div>
      <button onclick="document.querySelector('form[action=\'/cart/add\'] button[type=\'submit\']').click()" class="bg-[#E30613] text-white px-8 py-3 rounded-full font-black text-sm uppercase tracking-widest shadow-lg active:scale-95 transition-transform">
        Add to Cart
      </button>
    </div>

    <!-- Desktop View: Product info, variants, button -->
    <div class="hidden md:flex items-center gap-4 w-full">
      <img src="{{ product.featured_image | img_url: '100x' }}" alt="{{ product.title }}" class="w-12 h-12 rounded-[4px] object-cover bg-gray-50 border border-gray-100">
      <div class="flex-1">
        <p class="text-sm font-black text-gray-900">{{ product.title }}</p>
        <div class="flex items-center gap-2 text-xs">
          <span class="text-yellow-400">★★★★★</span>
          <span class="text-gray-500 font-bold">4.8</span>
        </div>
      </div>
      
      <div class="flex items-center gap-4 border-l border-gray-200 pl-4">
        <p class="text-xl font-black text-gray-900">{{ product.price | money }}</p>
        <button onclick="document.querySelector('form[action=\'/cart/add\'] button[type=\'submit\']').click()" class="bg-[#E30613] hover:bg-[#c20510] text-white px-10 py-3 rounded-[9999px] font-black text-sm uppercase tracking-widest shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
          Add to Cart
        </button>
      </div>
    </div>
    
  </div>
</div>

<script>
  // Simple intersection observer to show sticky ATC when the main ATC button scrolls out of view
  document.addEventListener('DOMContentLoaded', () => {
    const mainAtcButton = document.querySelector('form[action="/cart/add"] button[type="submit"]');
    const stickyBar = document.getElementById('sticky-atc-bar');
    
    if (mainAtcButton && stickyBar) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            // Main button scrolled up out of view
            stickyBar.classList.remove('translate-y-full');
          } else {
            // Main button is in view
            stickyBar.classList.add('translate-y-full');
          }
        });
      }, { threshold: 0 });
      
      observer.observe(mainAtcButton);
    }
  });
</script>

{% schema %}
{
  "name": "Sticky Add to Cart",
  "settings": [],
  "presets": [
    {
      "name": "Sticky Add to Cart",
      "category": "Product"
    }
  ]
}
{% endschema %}
