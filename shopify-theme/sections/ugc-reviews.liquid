<section class="py-24 px-4 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-black text-center text-gray-900 mb-12 tracking-tight">
      {{ section.settings.heading | default: "Don't just take our word for it." }}
    </h2>
    <div class="flex gap-6 overflow-x-auto hide-scrollbar pb-8 snap-x">
      {% for block in section.blocks %}
        <div class="w-[280px] shrink-0 aspect-[9/16] bg-gray-100 rounded-2xl overflow-hidden relative shadow-lg snap-center group cursor-pointer">
          {% if block.settings.video_url != blank %}
            <video src="{{ block.settings.video_url }}" autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"></video>
          {% elsif block.settings.cover_image != blank %}
            <img src="{{ block.settings.cover_image | img_url: '400x' }}" class="absolute inset-0 w-full h-full object-cover opacity-90" />
          {% else %}
            <div class="absolute inset-0 flex items-center justify-center bg-gray-200">
              <span class="material-symbols-outlined text-6xl text-gray-400">play_circle</span>
            </div>
          {% endif %}
          
          <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/80 to-transparent pointer-events-none">
            <div class="flex text-yellow-400 text-[14px] mb-1">★★★★★</div>
            <p class="text-white font-bold text-sm leading-tight">"{{ block.settings.quote }}"</p>
            <p class="text-gray-300 text-xs mt-1">{{ block.settings.handle }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Video Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't just take our word for it."
    }
  ],
  "blocks": [
    {
      "type": "ugc_video",
      "name": "Video Review",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (.mp4)"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover Image (Fallback)"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Review Quote",
          "default": "This completely changed how I do laundry!"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@ecocleaner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Video Reviews",
      "category": "Social Proof",
      "blocks": [
        { "type": "ugc_video", "settings": { "handle": "@user1" } },
        { "type": "ugc_video", "settings": { "handle": "@user2" } },
        { "type": "ugc_video", "settings": { "handle": "@user3" } },
        { "type": "ugc_video", "settings": { "handle": "@user4" } }
      ]
    }
  ]
}
{% endschema %}
