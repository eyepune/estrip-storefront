<div class="bg-white min-h-screen pb-24">
  
  <!-- Massive Hero -->
  <section class="relative w-full h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden bg-gray-900">
    <img src="{{ 'hero_background.png' | asset_url }}" alt="Our Story" class="absolute inset-0 w-full h-full object-cover opacity-50 mix-blend-screen" />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent"></div>
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-20">
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 tracking-tight">Cleaning up the cleaning industry.</h1>
      <p class="text-gray-300 font-medium text-xl max-w-2xl mx-auto">We're on a mission to eliminate single-use plastic from every laundry room in India.</p>
    </div>
  </section>

  <!-- The Problem -->
  <section class="py-24 px-4 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-24">
      <div class="w-full md:w-1/2 relative aspect-square rounded-3xl overflow-hidden shadow-2xl bg-gray-100">
        <img src="{{ 'plastic_waste.png' | asset_url }}" alt="Plastic Waste" class="absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 mix-blend-multiply" />
      </div>
      <div class="w-full md:w-1/2">
        <span class="text-[#E30613] font-black tracking-widest uppercase text-xs mb-4 block">The Problem</span>
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">90% water, packed in plastic.</h2>
        <p class="text-gray-600 font-medium text-lg mb-6 leading-relaxed">
          Traditional liquid detergents are mostly water. You are paying to ship heavy water in giant single-use plastic jugs across the country. Over 1 billion of these jugs are thrown away every year, and less than 10% are actually recycled.
        </p>
        <p class="text-gray-600 font-medium text-lg leading-relaxed">
          We knew there had to be a better way to get clean clothes without destroying the planet in the process.
        </p>
      </div>
    </div>
  </section>

  <!-- The Solution -->
  <section class="py-24 px-4 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row-reverse items-center gap-12 lg:gap-24">
      <div class="w-full md:w-1/2 relative aspect-square rounded-3xl overflow-hidden shadow-2xl bg-emerald-50">
        <img src="https://estrip.in/cdn/shop/files/pdp_s3.png?width=800" alt="E-strip Sheets" class="absolute inset-0 w-full h-full object-contain p-12 mix-blend-multiply" />
      </div>
      <div class="w-full md:w-1/2">
        <span class="text-emerald-500 font-black tracking-widest uppercase text-xs mb-4 block">The Solution</span>
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">Zero plastic. Maximum power.</h2>
        <p class="text-gray-600 font-medium text-lg mb-6 leading-relaxed">
          E-strip takes all the active cleaning ingredients from premium detergents, removes the water, and compresses them into a lightweight, pre-measured sheet. 
        </p>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 font-bold text-gray-700">
            <span class="material-symbols-outlined text-emerald-500 text-[24px]">eco</span>
            100% Compostable Cardboard Packaging
          </li>
          <li class="flex items-center gap-3 font-bold text-gray-700">
            <span class="material-symbols-outlined text-emerald-500 text-[24px]">local_shipping</span>
            Carbon Neutral Shipping
          </li>
          <li class="flex items-center gap-3 font-bold text-gray-700">
            <span class="material-symbols-outlined text-emerald-500 text-[24px]">water_drop</span>
            Dissolves completely in hot or cold water
          </li>
        </ul>
        <a href="/collections/all" class="btn bg-gray-900 text-white hover:bg-[#E30613] px-8 py-4 rounded-[9999px] font-bold text-sm tracking-widest shadow-lg inline-block">
          Shop The Solution
        </a>
      </div>
    </div>
  </section>

  <!-- Founder Story -->
  <section class="bg-[#f6f6f6] py-24 px-4 border-y border-gray-200">
    <div class="max-w-4xl mx-auto text-center">
      <div class="w-24 h-24 bg-gray-300 rounded-full mx-auto mb-8 overflow-hidden shadow-inner relative">
        <img src="https://estrip.in/cdn/shop/files/pdp_s1_1.png?width=200" alt="Founder" class="absolute inset-0 w-full h-full object-cover grayscale" />
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight">"We wanted to build a company our kids would be proud of."</h2>
      <p class="text-gray-600 text-lg font-medium leading-relaxed mb-8">
        When we realized the massive environmental impact of our daily household chores, we couldn't unsee it. We spent two years working with chemists to formulate a plant-based sheet that actually works as well as the toxic supermarket brands. E-strip is the result of that obsessive journey.
      </p>
      <span class="font-black text-gray-900 tracking-widest uppercase text-sm">— The Founders</span>
    </div>
  </section>

  <!-- Impact Stat Grid -->
  <section class="py-24 px-4 max-w-7xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-black text-center text-gray-900 mb-16 tracking-tight">Our Impact So Far</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white border-2 border-gray-100 rounded-3xl p-10 text-center hover:border-gray-900 transition-colors">
        <span class="text-5xl md:text-6xl font-black text-[#E30613] block mb-4">8M+</span>
        <h4 class="font-black text-gray-900 text-lg uppercase tracking-widest mb-2">Plastic Bottles</h4>
        <p class="text-gray-500 font-medium">Saved from landfills and oceans.</p>
      </div>
      <div class="bg-white border-2 border-gray-100 rounded-3xl p-10 text-center hover:border-gray-900 transition-colors">
        <span class="text-5xl md:text-6xl font-black text-emerald-500 block mb-4">100k+</span>
        <h4 class="font-black text-gray-900 text-lg uppercase tracking-widest mb-2">Trees Planted</h4>
        <p class="text-gray-500 font-medium">To offset our carbon footprint.</p>
      </div>
      <div class="bg-white border-2 border-gray-100 rounded-3xl p-10 text-center hover:border-gray-900 transition-colors">
        <span class="text-5xl md:text-6xl font-black text-blue-500 block mb-4">15k+</span>
        <h4 class="font-black text-gray-900 text-lg uppercase tracking-widest mb-2">Families Switched</h4>
        <p class="text-gray-500 font-medium">To a cleaner, greener routine.</p>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "About Page",
  "settings": []
}
{% endschema %}
