<div class="bg-white min-h-screen estrip-homepage">
  
  <!-- 1 & 2. Hero Banner (Scroll Video Sequence) -->
  <div id="hero-scroll-container" class="relative w-full" style="height: 300vh;">
    <div class="sticky top-0 w-full h-screen overflow-hidden bg-black flex items-center justify-center">
      <div id="hero-loader" class="absolute inset-0 flex items-center justify-center bg-black z-10 text-white font-bold transition-opacity duration-500">
        Loading Animation... <span id="hero-loader-text">0%</span>
      </div>
      <canvas id="hero-canvas" width="1920" height="1080" class="w-full h-full object-cover"></canvas>
      
      <div class="absolute inset-0 z-10 bg-gradient-to-b from-black/40 via-black/10 to-transparent pointer-events-none"></div>

      <div id="hero-text-container" class="absolute inset-0 z-20 flex flex-col items-center justify-center p-6 text-center pointer-events-none transition-transform duration-75">
        <h2 class="text-5xl md:text-7xl lg:text-8xl font-black text-white drop-shadow-2xl mb-6 tracking-tight">
          The Future of Clean.
        </h2>
        <p class="text-xl md:text-2xl text-white drop-shadow-xl font-medium max-w-2xl mb-10">
          Scroll to see how our plant-powered sheets dissolve instantly and power through stains.
        </p>
        <a href="/collections/all" class="pointer-events-auto btn bg-white text-gray-900 hover:bg-gray-200 px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-[9999px] shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
          Shop Now
        </a>
      </div>
    </div>
  </div>

  <!-- 3. Impact Bar -->
  <section class="bg-[#2B3F50] text-white py-4 md:py-6 overflow-hidden relative shadow-inner">
    <div class="flex whitespace-nowrap animate-marquee w-max">
      {% for i in (1..4) %}
        <div class="flex items-center gap-10 md:gap-20 px-5 md:px-10">
          <span class="text-xl md:text-2xl font-black uppercase tracking-widest">🌏 Over 8,200,000 Plastic Bottles Saved</span>
          <span class="text-xl md:text-2xl font-black uppercase tracking-widest text-[#ffe8e8]">Make the Switch Today</span>
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- 4. Featured Promo Cards Grid (Mockup Data for now, will map to Liquid Products in next iteration) -->
  <section class="py-20 px-4 max-w-7xl mx-auto bg-gray-50/50">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight">Our Best Sellers</h2>
      <p class="text-gray-500 font-medium text-lg">Save up to 50% when you bundle.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- We will inject Liquid product loop here later -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-gray-500">Products will dynamically load here from Shopify.</p>
      </div>
    </div>
  </section>

  <!-- 5. New Launch Banner -->
  <section class="bg-gradient-to-r from-blue-600 to-indigo-700 py-16 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
      <div class="text-left md:w-2/3">
        <span class="bg-yellow-400 text-yellow-900 text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-4 inline-block shadow-sm">New Launch</span>
        <h2 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">Meet the Stain Remover Spray</h2>
        <p class="text-blue-100 text-lg md:text-xl font-medium max-w-xl">Enzyme-activated spot cleaner that lifts fresh stains in seconds before they set.</p>
      </div>
      <div class="md:w-1/3 flex justify-end w-full">
        <a href="/products/stain-remover-spray" class="w-full md:w-auto text-center btn bg-yellow-400 hover:bg-yellow-300 text-yellow-900 px-10 py-5 rounded-[9999px] font-black text-sm uppercase tracking-widest shadow-[0_10px_30px_rgba(250,204,21,0.3)] hover:-translate-y-1 transition-transform">
          Shop Now — Up to 33% Off
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Logo Strip -->
  <section class="bg-white py-12 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4">
      <p class="text-center text-xs font-bold tracking-widest text-gray-400 uppercase mb-8">As Featured On</p>
      <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 grayscale hover:grayscale-0 transition-all duration-500">
         <span class="text-2xl md:text-3xl font-black font-serif">VOGUE</span>
         <span class="text-2xl md:text-3xl font-black">FORBES</span>
         <span class="text-2xl md:text-3xl font-black tracking-tighter">9NEWS</span>
         <span class="text-2xl md:text-3xl font-black italic">The New York Times</span>
      </div>
    </div>
  </section>

  <!-- 7. Shop By Category -->
  <section class="py-20 px-4 max-w-7xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-black text-center text-gray-900 mb-12 tracking-tight">Shop By Category</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      <a href="/collections/laundry" class="group flex flex-col items-center">
        <div class="w-full aspect-square bg-[#f6f6f6] rounded-2xl overflow-hidden mb-4 relative p-6 border border-gray-100 group-hover:border-gray-300 transition-colors">
          <img src="https://estrip.in/cdn/shop/files/pdp_s3.png?width=400" alt="Laundry" class="object-contain mix-blend-multiply p-4 group-hover:scale-110 transition-transform duration-500 w-full h-full" />
        </div>
        <span class="btn bg-[#2B3F50] text-white w-full py-3 rounded-full text-center text-xs font-bold tracking-widest group-hover:bg-[#1f2d39] transition-colors">Laundry</span>
      </a>
      <a href="/collections/kitchen" class="group flex flex-col items-center">
        <div class="w-full aspect-square bg-[#f6f6f6] rounded-2xl overflow-hidden mb-4 relative p-6 border border-gray-100 group-hover:border-gray-300 transition-colors">
          <img src="https://estrip.in/cdn/shop/files/pdp_s4.png?width=400" alt="Kitchen" class="object-contain mix-blend-multiply p-4 group-hover:scale-110 transition-transform duration-500 w-full h-full" />
        </div>
        <span class="btn bg-[#2B3F50] text-white w-full py-3 rounded-full text-center text-xs font-bold tracking-widest group-hover:bg-[#1f2d39] transition-colors">Kitchen</span>
      </a>
      <a href="/collections/bathroom" class="group flex flex-col items-center">
        <div class="w-full aspect-square bg-[#f6f6f6] rounded-2xl overflow-hidden mb-4 relative p-6 border border-gray-100 group-hover:border-gray-300 transition-colors">
          <img src="https://estrip.in/cdn/shop/files/pdp_s5.png?width=400" alt="Bathroom" class="object-contain mix-blend-multiply p-4 group-hover:scale-110 transition-transform duration-500 w-full h-full" />
        </div>
        <span class="btn bg-[#2B3F50] text-white w-full py-3 rounded-full text-center text-xs font-bold tracking-widest group-hover:bg-[#1f2d39] transition-colors">Bathroom</span>
      </a>
      <a href="/collections/baby" class="group flex flex-col items-center">
        <div class="w-full aspect-square bg-[#f6f6f6] rounded-2xl overflow-hidden mb-4 relative p-6 border border-gray-100 group-hover:border-gray-300 transition-colors">
          <img src="https://estrip.in/cdn/shop/files/pdp_s1_1.png?width=400" alt="Baby Care" class="object-contain mix-blend-multiply p-4 group-hover:scale-110 transition-transform duration-500 w-full h-full" />
        </div>
        <span class="btn bg-[#2B3F50] text-white w-full py-3 rounded-full text-center text-xs font-bold tracking-widest group-hover:bg-[#1f2d39] transition-colors">Baby Care</span>
      </a>
    </div>
  </section>

  <!-- 8. Before & After Social Proof -->
  <section class="bg-gray-900 py-24 px-4 text-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black mb-4 tracking-tight text-white">Seeing is Believing.</h2>
        <p class="text-gray-400 font-medium text-lg">Watch how our plant-based enzymes break down the toughest stains.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {% for i in (1..3) %}
        <div class="bg-gray-800 rounded-2xl overflow-hidden shadow-2xl aspect-[9/16] relative">
          <img src="https://estrip.in/cdn/shop/files/2_25.png?width=600" alt="Proof" class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-screen" />
          <div class="absolute inset-0 flex flex-col justify-between p-6">
            <div class="self-end bg-black/50 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold tracking-widest border border-white/20">
              Turmeric Stain
            </div>
            <div>
              <span class="material-symbols-outlined text-4xl mb-2 text-[#E30613] drop-shadow-md">play_circle</span>
              <p class="font-bold text-lg drop-shadow-md">"Completely vanished in cold water!"</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 10. Trust Badges -->
  <section class="bg-[#f6f6f6] py-16 px-4 border-t border-gray-200">
    <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-sm mb-4">
          <span class="material-symbols-outlined text-[32px] text-gray-900">verified</span>
        </div>
        <h4 class="font-black text-gray-900 text-sm tracking-wide uppercase">30-Day Guarantee</h4>
        <p class="text-xs text-gray-500 mt-1 font-medium">Love it or your money back</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-sm mb-4">
          <span class="material-symbols-outlined text-[32px] text-gray-900">rate_review</span>
        </div>
        <h4 class="font-black text-gray-900 text-sm tracking-wide uppercase">10,000+ Reviews</h4>
        <p class="text-xs text-gray-500 mt-1 font-medium">From happy customers</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-sm mb-4">
          <span class="material-symbols-outlined text-[32px] text-gray-900">eco</span>
        </div>
        <h4 class="font-black text-gray-900 text-sm tracking-wide uppercase">Plastic Free</h4>
        <p class="text-xs text-gray-500 mt-1 font-medium">100% compostable packaging</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-sm mb-4">
          <span class="material-symbols-outlined text-[32px] text-gray-900">local_shipping</span>
        </div>
        <h4 class="font-black text-gray-900 text-sm tracking-wide uppercase">Carbon Neutral</h4>
        <p class="text-xs text-gray-500 mt-1 font-medium">Shipping on every order</p>
      </div>
    </div>
  </section>

  <!-- 12. Benefit Grid -->
  <section class="py-24 px-4 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight">Small Sheets. Massive Impact.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 group">
          <div class="aspect-[4/3] bg-pink-50 relative overflow-hidden">
            <img src="{{ 'plastic_waste.png' | asset_url }}" alt="No Plastic" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 mix-blend-multiply" />
          </div>
          <div class="p-8 text-center">
            <h3 class="text-xl font-black text-gray-900 mb-3">No Plastic Jugs</h3>
            <p class="text-gray-500 font-medium">Over 1 billion plastic laundry jugs are discarded every year. Our cardboard packaging is 100% compostable and recyclable.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 group">
          <div class="aspect-[4/3] bg-blue-50 relative overflow-hidden flex items-center justify-center">
            <span class="material-symbols-outlined text-[100px] text-blue-200">water_drop</span>
          </div>
          <div class="p-8 text-center">
            <h3 class="text-xl font-black text-gray-900 mb-3">No Artificial Dyes</h3>
            <p class="text-gray-500 font-medium">Traditional detergents are 90% water and packed with optical brighteners and synthetic dyes. We use only what's needed to clean.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 group">
          <div class="aspect-[4/3] bg-emerald-50 relative overflow-hidden flex items-center justify-center">
            <span class="material-symbols-outlined text-[100px] text-emerald-200">scale</span>
          </div>
          <div class="p-8 text-center">
            <h3 class="text-xl font-black text-gray-900 mb-3">Lightweight & Pre-Measured</h3>
            <p class="text-gray-500 font-medium">No more measuring sticky liquid or dealing with messy powder spills. Simply toss in one ultra-concentrated sheet and you're done.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 14. Plant Derived Ingredients Carousel -->
  <section class="py-24 px-4 bg-emerald-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[url('{{ 'coconut_splash.png' | asset_url }}')] bg-cover bg-center"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <h2 class="text-3xl md:text-5xl font-black text-center mb-16 tracking-tight">Powered by Nature.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        <div class="bg-emerald-800/50 backdrop-blur-sm p-6 rounded-2xl border border-emerald-700/50">
          <div class="w-12 h-12 bg-emerald-700 rounded-full flex items-center justify-center mb-4"><span class="material-symbols-outlined">psychiatry</span></div>
          <h4 class="font-black text-lg mb-2">Coconut Surfactants</h4>
          <p class="text-emerald-100 text-sm font-medium">Naturally lifts dirt and grease without stripping fabrics.</p>
        </div>
        <div class="bg-emerald-800/50 backdrop-blur-sm p-6 rounded-2xl border border-emerald-700/50">
          <div class="w-12 h-12 bg-emerald-700 rounded-full flex items-center justify-center mb-4"><span class="material-symbols-outlined">bubble_chart</span></div>
          <h4 class="font-black text-lg mb-2">5-Enzyme Blend</h4>
          <p class="text-emerald-100 text-sm font-medium">Targets specific stains like proteins, starches, and oils at the molecular level.</p>
        </div>
        <div class="bg-emerald-800/50 backdrop-blur-sm p-6 rounded-2xl border border-emerald-700/50">
          <div class="w-12 h-12 bg-emerald-700 rounded-full flex items-center justify-center mb-4"><span class="material-symbols-outlined">water_drop</span></div>
          <h4 class="font-black text-lg mb-2">Essential Oils</h4>
          <p class="text-emerald-100 text-sm font-medium">Provides a light, natural scent without overpowering synthetic fragrances.</p>
        </div>
        <div class="bg-emerald-800/50 backdrop-blur-sm p-6 rounded-2xl border border-emerald-700/50">
          <div class="w-12 h-12 bg-emerald-700 rounded-full flex items-center justify-center mb-4"><span class="material-symbols-outlined">layers</span></div>
          <h4 class="font-black text-lg mb-2">PVA Film</h4>
          <p class="text-emerald-100 text-sm font-medium">A biodegradable polymer that dissolves completely leaving zero microplastics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 15. UGC Video Reviews -->
  <section class="py-24 px-4 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-black text-center text-gray-900 mb-12 tracking-tight">Don't just take our word for it.</h2>
      <div class="flex gap-6 overflow-x-auto hide-scrollbar pb-8 snap-x">
        {% for i in (1..5) %}
        <div class="w-[280px] shrink-0 aspect-[9/16] bg-gray-100 rounded-2xl overflow-hidden relative shadow-lg snap-center">
          <div class="absolute inset-0 flex items-center justify-center bg-gray-200">
            <span class="material-symbols-outlined text-6xl text-gray-400">play_circle</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
            <div class="flex text-yellow-400 text-[14px] mb-1">★★★★★</div>
            <p class="text-white font-bold text-sm leading-tight">"This completely changed how I do laundry!"</p>
            <p class="text-gray-300 text-xs mt-1">@ecocleaner_{{ i }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 16. Brand Mission -->
  <section class="w-full bg-[#f6f6f6] py-24 text-center px-4 border-y border-gray-200">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-6 tracking-tight">Why E-strip?</h2>
      <p class="text-lg md:text-xl text-gray-600 font-medium mb-10 leading-relaxed">
        We looked at the cleaning aisle and saw a problem: outdated formats that were heavy on the planet and weak on performance. We believe that high-quality performance and planetary responsibility shouldn't be a choice—they must go hand in hand. Every sheet we produce is a step towards a cleaner home and a healthier earth.
      </p>
      <a href="/pages/about" class="btn bg-gray-900 text-white hover:bg-[#E30613] px-10 py-4 rounded-[9999px] font-bold text-sm tracking-widest shadow-lg inline-block">
        Read Our Full Story
      </a>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "E-Strip Homepage",
  "settings": [],
  "presets": [
    {
      "name": "E-Strip Homepage"
    }
  ]
}
{% endschema %}
