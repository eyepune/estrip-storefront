<section class="bg-gradient-to-r from-blue-600 to-indigo-700 py-16 px-4 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
  <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
    <div class="text-left md:w-2/3">
      <span class="bg-yellow-400 text-yellow-900 text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-4 inline-block shadow-sm">
        {{ section.settings.badge | default: "New Launch" }}
      </span>
      <h2 class="text-3xl md:text-5xl font-black text-white mb-4 leading-tight tracking-tight">
        {{ section.settings.heading | default: "Meet the Stain Remover Spray" }}
      </h2>
      <p class="text-blue-100 text-lg md:text-xl font-medium max-w-xl">
        {{ section.settings.subheading | default: "Enzyme-activated spot cleaner that lifts fresh stains in seconds before they set." }}
      </p>
    </div>
    <div class="md:w-1/3 flex justify-end w-full">
      <a href="{{ section.settings.button_link | default: '#' }}" class="w-full md:w-auto text-center btn bg-yellow-400 hover:bg-yellow-300 text-yellow-900 px-10 py-5 rounded-[9999px] font-black text-sm uppercase tracking-widest shadow-[0_10px_30px_rgba(250,204,21,0.3)] hover:-translate-y-1 transition-transform">
        {{ section.settings.button_label | default: "Shop Now — Up to 33% Off" }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "New Launch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Stain Remover Spray"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Enzyme-activated spot cleaner that lifts fresh stains in seconds before they set."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now — Up to 33% Off"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "category": "Banner"
    }
  ]
}
{% endschema %}
