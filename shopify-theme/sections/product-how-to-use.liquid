<section class="py-24 px-4 bg-white border-t border-gray-100">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <span class="bg-[#eaf4f0] text-emerald-800 text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-4 inline-block">
        {{ section.settings.badge | default: "How to Use" }}
      </span>
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight">
        {{ section.settings.heading | default: "As easy as Toss, Wash, Done." }}
      </h2>
      <p class="text-gray-500 font-medium text-lg">
        {{ section.settings.subheading | default: "No measuring, no mess, no heavy plastic jugs." }}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center relative">
      <!-- Decorative connecting line (desktop only) -->
      <div class="hidden md:block absolute top-16 left-[16%] right-[16%] h-1 bg-gradient-to-r from-gray-100 via-gray-300 to-gray-100 -z-10 rounded-full"></div>

      <!-- Step 1 -->
      <div class="flex flex-col items-center">
        <div class="w-32 h-32 bg-gray-50 rounded-full flex items-center justify-center mb-6 shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-gray-100">
          {% if section.settings.icon_1 != blank %}
            <img src="{{ section.settings.icon_1 | img_url: '200x' }}" alt="Step 1" class="w-16 h-16 object-contain" />
          {% else %}
            <span class="material-symbols-outlined text-[60px] text-[#2B3F50]">dry_cleaning</span>
          {% endif %}
        </div>
        <div class="bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-black text-sm -mt-10 mb-4 relative z-10 border-4 border-white shadow-sm">1</div>
        <h3 class="text-xl font-black text-gray-900 mb-2">{{ section.settings.step_1_title | default: "Toss" }}</h3>
        <p class="text-gray-500 font-medium">{{ section.settings.step_1_desc | default: "Toss 1 sheet directly into the washer drum. (Use 2 for heavy loads)." }}</p>
      </div>

      <!-- Step 2 -->
      <div class="flex flex-col items-center">
        <div class="w-32 h-32 bg-gray-50 rounded-full flex items-center justify-center mb-6 shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-gray-100">
          {% if section.settings.icon_2 != blank %}
            <img src="{{ section.settings.icon_2 | img_url: '200x' }}" alt="Step 2" class="w-16 h-16 object-contain" />
          {% else %}
            <span class="material-symbols-outlined text-[60px] text-[#2B3F50]">local_laundry_service</span>
          {% endif %}
        </div>
        <div class="bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-black text-sm -mt-10 mb-4 relative z-10 border-4 border-white shadow-sm">2</div>
        <h3 class="text-xl font-black text-gray-900 mb-2">{{ section.settings.step_2_title | default: "Add Clothes" }}</h3>
        <p class="text-gray-500 font-medium">{{ section.settings.step_2_desc | default: "Add your laundry. Works in all machines including HE." }}</p>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-col items-center">
        <div class="w-32 h-32 bg-gray-50 rounded-full flex items-center justify-center mb-6 shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-gray-100">
          {% if section.settings.icon_3 != blank %}
            <img src="{{ section.settings.icon_3 | img_url: '200x' }}" alt="Step 3" class="w-16 h-16 object-contain" />
          {% else %}
            <span class="material-symbols-outlined text-[60px] text-[#2B3F50]">checkroom</span>
          {% endif %}
        </div>
        <div class="bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-black text-sm -mt-10 mb-4 relative z-10 border-4 border-white shadow-sm">3</div>
        <h3 class="text-xl font-black text-gray-900 mb-2">{{ section.settings.step_3_title | default: "Wash & Done" }}</h3>
        <p class="text-gray-500 font-medium">{{ section.settings.step_3_desc | default: "Start your normal cycle. The sheet dissolves instantly in any temperature." }}</p>
      </div>
    </div>
  </div>
</section>

