<section class="bg-white py-12 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4">
    <p class="text-center text-xs font-bold tracking-widest text-gray-400 uppercase mb-8">
      {{ section.settings.heading | default: "As Featured On" }}
    </p>
    <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 grayscale hover:grayscale-0 transition-all duration-500">
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}
          <img src="{{ block.settings.logo | img_url: '200x' }}" alt="Press Logo" class="h-8 md:h-10 object-contain">
        {% else %}
          <span class="text-2xl md:text-3xl font-black font-serif text-gray-800">{{ block.settings.fallback_text | default: "PRESS" }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo Strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Featured On"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "fallback_text",
          "label": "Fallback Text (if no image)",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Strip",
      "category": "Trust",
      "blocks": [
        { "type": "logo", "settings": { "fallback_text": "VOGUE" } },
        { "type": "logo", "settings": { "fallback_text": "FORBES" } },
        { "type": "logo", "settings": { "fallback_text": "9NEWS" } },
        { "type": "logo", "settings": { "fallback_text": "The New York Times" } }
      ]
    }
  ]
}
{% endschema %}
