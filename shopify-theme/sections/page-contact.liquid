<div class="bg-white min-h-screen py-24 px-4">
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-16">
    
    <div class="w-full md:w-1/2">
      <span class="text-[#E30613] font-black tracking-widest uppercase text-xs mb-4 block">Get In Touch</span>
      <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 tracking-tight">We're here to help.</h1>
      <p class="text-gray-500 font-medium text-lg mb-8">Have a question about your order, subscriptions, or just want to chat about eco-friendly cleaning? Send us a message.</p>
      
      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center">
            <span class="material-symbols-outlined text-gray-600">email</span>
          </div>
          <div>
            <h4 class="font-bold text-gray-900">Email Us</h4>
            <p class="text-gray-500 font-medium">support@estrip.in</p>
          </div>
        </div>
      </div>
    </div>

    <div class="w-full md:w-1/2">
      <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="bg-emerald-50 text-emerald-700 p-4 rounded-xl mb-6 font-bold text-sm">
              Thanks for contacting us! We'll get back to you as soon as possible.
            </div>
          {% endif %}
          
          {{ form.errors | default_errors }}
          
          <div class="space-y-4">
            <div>
              <label for="ContactFormName" class="block text-xs font-bold text-gray-700 uppercase tracking-widest mb-2">Name</label>
              <input type="text" id="ContactFormName" name="contact[name]" class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-gray-900 transition-colors" placeholder="Jane Doe">
            </div>
            <div>
              <label for="ContactFormEmail" class="block text-xs font-bold text-gray-700 uppercase tracking-widest mb-2">Email</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" autocorrect="off" autocapitalize="off" class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-gray-900 transition-colors" placeholder="jane@example.com">
            </div>
            <div>
              <label for="ContactFormMessage" class="block text-xs font-bold text-gray-700 uppercase tracking-widest mb-2">Message</label>
              <textarea rows="5" id="ContactFormMessage" name="contact[body]" class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-gray-900 transition-colors" placeholder="How can we help?"></textarea>
            </div>
            <button type="submit" class="btn w-full bg-gray-900 text-white hover:bg-[#E30613] py-4 rounded-[9999px] font-bold text-sm tracking-widest uppercase shadow-lg transition-colors mt-4">
              Send Message
            </button>
          </div>
        {% endform %}
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
