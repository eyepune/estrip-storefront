<div class="min-h-screen bg-white">
  <!-- Breadcrumb -->
  <div class="bg-[#f6f6f6] py-3 px-4 border-b border-gray-100">
    <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-bold tracking-widest text-gray-500 uppercase">
      <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/collections/all" class="hover:text-gray-900 transition-colors">Shop</a>
      <span>/</span>
      <span class="text-gray-900">{{ product.title }}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Media Gallery -->
      <div class="w-full lg:w-3/5 lg:sticky lg:top-24">
        <div class="flex gap-4">
          <!-- Thumbnail strip (Desktop) -->
          <div class="hidden lg:flex flex-col gap-3 w-20 shrink-0">
            {% for image in product.images %}
              <button
                class="gallery-thumbnail relative w-20 h-20 rounded-[4px] bg-gray-50 border border-gray-200 hover:border-gray-300 overflow-hidden transition-all {% if forloop.first %}border-gray-900{% endif %}"
                data-image-id="{{ image.id }}"
                data-image-src="{{ image | img_url: 'master' }}"
              >
                <img src="{{ image | img_url: '100x' }}" alt="{{ product.title }} view {{ forloop.index }}" class="w-full h-full object-contain p-2" />
              </button>
            {% endfor %}
          </div>
          
          <!-- Main Image -->
          <div class="relative w-full aspect-square bg-[#f6f6f6] rounded-[10px] overflow-hidden">
            <img
              id="MainProductImage"
              src="{{ product.featured_image | img_url: 'master' }}"
              alt="{{ product.title }}"
              class="w-full h-full object-contain p-4 mix-blend-multiply"
            />
            {% if product.metafields.custom.badge %}
              <div class="absolute top-4 left-4 bg-gray-900 text-white text-xs font-black px-3 py-1 rounded-[4px] uppercase tracking-wide">
                {{ product.metafields.custom.badge }}
              </div>
            {% endif %}
          </div>
        </div>
        
        <!-- Thumbnail strip (Mobile) -->
        {% if product.images.size > 1 %}
          <div class="flex lg:hidden gap-3 mt-4 overflow-x-auto hide-scrollbar pb-2">
            {% for image in product.images %}
              <button
                class="gallery-thumbnail-mobile relative w-16 h-16 shrink-0 rounded-[4px] bg-gray-50 border border-gray-200 overflow-hidden transition-all {% if forloop.first %}border-gray-900{% endif %}"
                data-image-id="{{ image.id }}"
                data-image-src="{{ image | img_url: 'master' }}"
              >
                <img src="{{ image | img_url: '100x' }}" alt="{{ product.title }} view {{ forloop.index }}" class="w-full h-full object-contain p-1" />
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Right Column: Product Details -->
      <div class="w-full lg:w-2/5 flex flex-col pt-2">
        
        <!-- Reviews Summary -->
        <div class="flex items-center gap-2 mb-3 cursor-pointer hover:opacity-80 transition-opacity accordion-trigger" data-target="accordion-reviews">
          <div class="flex gap-0.5">
            <span class="text-gray-900 material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1">star</span>
            <span class="text-gray-900 material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1">star</span>
            <span class="text-gray-900 material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1">star</span>
            <span class="text-gray-900 material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1">star</span>
            <span class="text-gray-900 material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1">star</span>
          </div>
          <span class="text-sm text-gray-500 font-bold">4.9 (1,294 reviews)</span>
        </div>

        <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-2 leading-tight">{{ product.title }}</h1>
        <p class="text-gray-600 text-base mb-6 font-medium">{{ product.metafields.custom.subtitle }}</p>

        <!-- Form for ATC -->
        <form method="post" action="/cart/add" id="AddToCartForm" class="m-0 p-0">
          <!-- Hidden Variant Selection -->
          <select name="id" id="ProductSelect" class="hidden">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" data-price="{{ variant.price | money }}">{{ variant.title }}</option>
            {% endfor %}
          </select>

          <!-- Price -->
          <div class="flex items-baseline gap-3 mb-8">
            <span id="ProductPrice" class="text-2xl font-black text-gray-900">{{ product.price | money }}</span>
          </div>

          <!-- Quantity & Add to Cart -->
          <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <div class="flex items-center border border-gray-300 rounded-[4px] overflow-hidden w-full sm:w-32 h-[50px] shrink-0">
              <button type="button" class="qty-minus flex-1 h-full text-gray-600 hover:bg-gray-50 font-bold text-xl transition-colors">−</button>
              <input type="text" name="quantity" id="Quantity" value="1" min="1" class="w-10 text-center font-black text-gray-900 text-sm border-0 focus:ring-0 p-0" readonly />
              <button type="button" class="qty-plus flex-1 h-full text-gray-600 hover:bg-gray-50 font-bold text-xl transition-colors">+</button>
            </div>
            <button
              type="submit"
              name="add"
              id="AddToCart"
              class="btn flex-1 h-[50px] bg-[#1A202C] text-white hover:opacity-90 font-bold text-sm transition-all flex items-center justify-center gap-2 tracking-widest uppercase rounded-[9999px]"
            >
              Add to Cart
            </button>
          </div>
        </form>
        
        <!-- Trust strip -->
        <div class="flex items-center justify-center gap-6 py-4 mb-8 border-y border-gray-100 opacity-70">
          <span class="material-symbols-outlined text-[24px]">local_shipping</span>
          <span class="material-symbols-outlined text-[24px]">eco</span>
          <span class="material-symbols-outlined text-[24px]">workspace_premium</span>
        </div>

        <!-- Accordions (Vanilla JS controlled via 'accordion-trigger' and 'accordion-content') -->
        <div class="border-t border-gray-200">
          <!-- Description Accordion -->
          <div class="border-b border-gray-200">
            <button 
              type="button"
              class="accordion-trigger w-full flex justify-between items-center py-5 text-left focus:outline-none"
              data-target="accordion-desc"
            >
              <span class="font-bold text-gray-900 tracking-wide uppercase text-sm">Description</span>
              <span class="material-symbols-outlined text-gray-500 accordion-icon">remove</span>
            </button>
            <div id="accordion-desc" class="accordion-content pb-6 text-gray-600 text-sm leading-relaxed font-medium block">
              {{ product.description }}
            </div>
          </div>

          <!-- Ingredients Accordion -->
          <div class="border-b border-gray-200">
            <button 
              type="button"
              class="accordion-trigger w-full flex justify-between items-center py-5 text-left focus:outline-none"
              data-target="accordion-ingr"
            >
              <span class="font-bold text-gray-900 tracking-wide uppercase text-sm">What's in it?</span>
              <span class="material-symbols-outlined text-gray-500 accordion-icon">add</span>
            </button>
            <div id="accordion-ingr" class="accordion-content pb-6 text-gray-600 text-sm leading-relaxed font-medium hidden">
              <p class="mb-3">Made with powerful plant-based ingredients. Free from harsh chemicals and optical brighteners.</p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-gray-100 px-3 py-1 rounded-[4px] text-xs font-bold text-gray-700">Coconut Surfactants</span>
                <span class="bg-gray-100 px-3 py-1 rounded-[4px] text-xs font-bold text-gray-700">5-Enzyme Blend</span>
              </div>
            </div>
          </div>

          <!-- Reviews Accordion -->
          <div class="border-b border-gray-200">
            <button 
              type="button"
              class="accordion-trigger w-full flex justify-between items-center py-5 text-left focus:outline-none"
              data-target="accordion-reviews"
            >
              <span class="font-bold text-gray-900 tracking-wide uppercase text-sm">Customer Reviews</span>
              <span class="material-symbols-outlined text-gray-500 accordion-icon">add</span>
            </button>
            <div id="accordion-reviews" class="accordion-content pb-6 space-y-4 hidden">
              <div class="p-4 bg-[#f6f6f6] rounded-[10px]">
                <div class="flex items-center justify-between mb-2">
                  <div>
                    <span class="font-black text-gray-900 mr-2 text-sm">Priya S.</span>
                    <span class="text-[10px] bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-[4px]">Verified</span>
                  </div>
                  <div class="flex">
                    <span class="text-[12px] text-gray-900 material-symbols-outlined" style="font-variation-settings: 'FILL' 1">star</span>
                  </div>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed font-medium">Absolutely love this!</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Sticky Mobile ATC -->
  <div class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-white border-t border-gray-200 px-4 py-3 safe-area-bottom shadow-[0_-10px_20px_rgba(0,0,0,0.05)]">
    <button
      onclick="document.getElementById('AddToCart').click()"
      class="btn w-full h-[50px] bg-[#1A202C] text-white font-bold text-sm flex items-center justify-center gap-2 transition-all tracking-widest uppercase rounded-[9999px]"
    >
      Add to Cart
    </button>
  </div>
</div>
