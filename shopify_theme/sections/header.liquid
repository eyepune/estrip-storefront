<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-open" class="md:hidden flex items-center justify-center p-2 text-gray-900 focus:outline-none">
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 flex items-center absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0">
      <span class="text-2xl md:text-3xl font-black tracking-tighter text-gray-900">E-strip<span class="text-[#e040a0]">.</span></span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex space-x-8">
      <a href="/collections/all" class="text-sm font-bold text-gray-900 hover:text-[#e040a0] transition-colors tracking-wide">Shop All</a>
      <a href="/collections/bundles" class="text-sm font-bold text-gray-900 hover:text-[#e040a0] transition-colors tracking-wide">Bundles</a>
      <a href="/pages/about-us" class="text-sm font-bold text-gray-900 hover:text-[#e040a0] transition-colors tracking-wide">About Us</a>
      <a href="/pages/faq" class="text-sm font-bold text-gray-900 hover:text-[#e040a0] transition-colors tracking-wide">FAQ</a>
      <a href="/pages/reviews" class="text-sm font-bold text-gray-900 hover:text-[#e040a0] transition-colors tracking-wide">Reviews</a>
    </nav>

    <!-- Icons -->
    <div class="flex items-center space-x-6">
      <a href="/account" class="hidden md:flex text-gray-900 hover:text-[#e040a0] transition-colors">
        <span class="material-symbols-outlined text-[28px]">person</span>
      </a>
      
      <!-- Cart Toggle -->
      <button id="cart-drawer-open" class="text-gray-900 hover:text-[#e040a0] transition-colors relative">
        <span class="material-symbols-outlined text-[28px]">shopping_bag</span>
        <span class="cart-item-count absolute -top-1 -right-2 bg-[#e040a0] text-white text-[10px] font-black rounded-full h-5 w-5 flex items-center justify-center border-2 border-white shadow-sm">
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Hidden by default) -->
  <div id="mobile-menu-drawer" class="fixed inset-0 bg-white z-[100] transform -translate-x-full transition-transform duration-300 flex flex-col">
    <div class="p-4 flex justify-between items-center border-b border-gray-100">
      <span class="text-2xl font-black tracking-tighter text-gray-900">E-strip<span class="text-[#e040a0]">.</span></span>
      <button id="mobile-menu-close" class="p-2 text-gray-900">
        <span class="material-symbols-outlined text-3xl">close</span>
      </button>
    </div>
    <nav class="p-6 flex flex-col space-y-6">
      <a href="/collections/all" class="text-2xl font-black text-gray-900">Shop All</a>
      <a href="/collections/bundles" class="text-2xl font-black text-gray-900">Bundles</a>
      <a href="/pages/about-us" class="text-2xl font-black text-gray-900">About Us</a>
      <a href="/pages/faq" class="text-2xl font-black text-gray-900">FAQ</a>
      <a href="/pages/reviews" class="text-2xl font-black text-gray-900">Reviews</a>
      <div class="pt-6 mt-6 border-t border-gray-100">
        <a href="/account" class="flex items-center text-lg font-bold text-gray-900">
          <span class="material-symbols-outlined mr-3">person</span>
          Account Login
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Cart Drawer (Hidden by default) -->
<div id="cart-overlay" class="fixed inset-0 bg-black/50 z-[100] opacity-0 pointer-events-none transition-opacity duration-300"></div>
<div id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[500px] bg-white z-[110] transform translate-x-full transition-transform duration-300 flex flex-col shadow-2xl">
  
  <!-- Header -->
  <div class="flex items-center justify-between p-6 border-b border-gray-100">
    <h2 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Your Cart</h2>
    <button id="cart-drawer-close" class="text-gray-400 hover:text-gray-900 transition-colors">
      <span class="material-symbols-outlined text-3xl">close</span>
    </button>
  </div>

  <!-- Free Shipping Progress -->
  <div class="px-6 py-4 bg-[#f6f6f6] border-b border-gray-100 text-center">
    <p class="text-sm font-bold text-gray-900 mb-2">You are <span id="cart-shipping-away" class="text-[#e040a0]">₹500</span> away from FREE shipping!</p>
    <div class="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden">
      <div id="cart-shipping-bar" class="bg-gray-900 h-full rounded-full transition-all duration-500" style="width: 50%"></div>
    </div>
  </div>

  <!-- Cart Items Container -->
  <div id="cart-items-container" class="flex-grow overflow-y-auto p-6 space-y-6">
    <!-- Items will be injected here via Vanilla JS using Shopify AJAX API -->
    <div class="text-center py-20 text-gray-500 font-medium">Loading cart...</div>
  </div>

  <!-- Footer -->
  <div class="p-6 border-t border-gray-100 bg-white">
    <div class="flex justify-between items-center mb-6">
      <span class="font-bold text-gray-900 uppercase tracking-widest text-sm">Subtotal</span>
      <span id="cart-subtotal" class="font-black text-2xl text-gray-900">{{ cart.total_price | money }}</span>
    </div>
    <form action="/checkout" method="post" class="m-0 p-0">
      <button type="submit" name="checkout" class="btn w-full bg-[#1A202C] text-white hover:opacity-90 py-4 font-bold text-sm transition-all tracking-widest uppercase rounded-[9999px] flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[18px]">lock</span>
        Checkout Securely
      </button>
    </form>
    <p class="text-center text-xs text-gray-400 font-medium mt-4">Shipping & taxes calculated at checkout.</p>
  </div>
</div>
